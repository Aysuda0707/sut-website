# =============================================================================
# Environment configuration example
# Copy this file to `.env.local` for local development.
# NEVER commit real secrets. This file must contain placeholders only.
# =============================================================================

# --- Public site -------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="گروه دانشجویی آذربایجان — دانشگاه صنعتی شریف"

# --- Directus CMS (Phase 3+) -------------------------------------------------
# Base URL of the Directus instance.
DIRECTUS_URL=http://localhost:8055
# Read-only token used by the frontend to fetch PUBLISHED content only.
# Create a dedicated role/token in Directus with read access to published items.
DIRECTUS_STATIC_TOKEN=replace-with-read-only-token
# Preview token for draft preview (Phase 3+).
DIRECTUS_PREVIEW_TOKEN=replace-with-preview-token

# --- PostgreSQL (Phase 3+) ---------------------------------------------------
# Used by Directus. Not exposed to the frontend.
POSTGRES_DB=directus
POSTGRES_USER=directus
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Directus secrets (Phase 3+) ---------------------------------------------
# Generate with: openssl rand -hex 32
DIRECTUS_KEY=replace-with-random-key
DIRECTUS_SECRET=replace-with-random-secret
DIRECTUS_ADMIN_EMAIL=admin@example.com
DIRECTUS_ADMIN_PASSWORD=replace-with-strong-password

# --- S3-compatible object storage (Phase 4+) ---------------------------------
STORAGE_S3_ENDPOINT=http://localhost:9000
STORAGE_S3_REGION=us-east-1
STORAGE_S3_BUCKET=sut-archive-media
STORAGE_S3_ACCESS_KEY=replace-with-access-key
STORAGE_S3_SECRET_KEY=replace-with-secret-key
STORAGE_S3_FORCE_PATH_STYLE=true

# --- Media limits (Phase 4+) -------------------------------------------------
# Maximum upload sizes in megabytes, per media type.
MEDIA_MAX_IMAGE_MB=25
MEDIA_MAX_AUDIO_MB=200
MEDIA_MAX_VIDEO_MB=2048

# --- Built-in admin panel ----------------------------------------------------
# Password for the /admin panel. If unset, the default "admin" is used and a
# warning is shown in the panel. Set a strong value in production.
ADMIN_PASSWORD=replace-with-strong-password
# HMAC key used to sign admin session cookies. Generate with: openssl rand -hex 32
# If unset, a random per-process secret is used (sessions reset on restart).
ADMIN_SESSION_SECRET=replace-with-random-secret
